{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlScriptDOM LSP initialization options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dialect": { "const": "tsql" },
        "mode": { "enum": ["offline", "online"] },
        "parserVersion": { "enum": ["80", "90", "100", "110", "120", "130", "140", "150", "160", "170", "180"] },
        "quotedIdentifier": { "type": "boolean" }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseSensitive": { "type": "boolean" },
        "defaultSchema": { "type": "string", "minLength": 1 },
        "defaultDatabase": { "type": "string", "minLength": 1 },
        "defaultDatabaseProfile": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFileSizeBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "scanInOnline": { "type": "boolean", "default": false }
      }
    },
    "databases": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "connectionStringEnv", "environment", "server", "database", "readOnly"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "connectionStringEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" },
          "environment": { "type": "string", "minLength": 1, "maxLength": 64 },
          "server": { "type": "string", "minLength": 1, "maxLength": 256 },
          "database": { "type": "string", "minLength": 1, "maxLength": 128 },
          "enabled": { "type": "boolean", "default": false },
          "readOnly": { "const": true },
          "caseSensitive": { "type": "boolean" },
          "connectTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
          "commandTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
          "loadTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
          "maxObjects": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "maxMembersPerObject": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "maxDependenciesPerObject": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "maxModuleCharacters": { "type": "integer", "minimum": 1, "maximum": 2097152 },
          "cacheTtlSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
          "schemas": { "type": "array", "uniqueItems": true, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
        }
      }
    }
  }
}
