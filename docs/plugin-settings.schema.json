{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SqlScriptDOM local plugin settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "metrics": { "$ref": "#/$defs/storage" },
    "analysisCache": { "$ref": "#/$defs/storage" },
    "indexCache": { "$ref": "#/$defs/storage" },
    "responses": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "discoveryMaxBytes": { "type": "integer", "minimum": 8192, "maximum": 16384, "default": 16384 },
        "analysisMaxBytes": { "type": "integer", "minimum": 16384, "maximum": 65536, "default": 32768 }
      }
    }
  },
  "$defs": {
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "directory": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" }
      }
    }
  }
}
